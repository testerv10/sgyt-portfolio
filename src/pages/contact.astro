---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — SlayerGamerYT" description="Get in touch with SlayerGamerYT for projects, collaborations, and inquiries." canonical="https://slayergamer.eu.org/contact">

  <section class="page-hero section">
    <div class="wrap">
      <span class="section__label blink-text">// get_in_touch</span>
      <h1 class="page-hero__title reveal glitch" data-text="Contact">Contact</h1>
      <p class="page-hero__sub reveal" style="--delay:.1s">Have a project? Drop a message. I respond to every serious inquiry.</p>
    </div>
  </section>

  <section class="contact-section section">
    <div class="wrap contact-wrap">
      <div class="contact-info reveal reveal--left">
        <h2 class="contact-info__title">Have a project?<br/><span class="stroke-text">Let's make it real.</span></h2>
        <p class="contact-info__sub">Reach out directly or use the form. Whether it's a new build, a collab, or just a question — I'm listening.</p>
        <a href="mailto:admin@slayergamer.eu.org" class="contact-info__email">admin@slayergamer.eu.org</a>
        <ul class="contact-socials">
          <li>
            <a href="https://youtube.com/@SGYT_0007" target="_blank" rel="noopener noreferrer" class="social-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
              <span><strong>YouTube</strong>@SGYT_0007</span>
              <svg class="social-row__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1.5 12.5L12.5 1.5M12.5 1.5H5.5M12.5 1.5V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
          <li>
            <a href="https://instagram.com/slayergameryt_0007" target="_blank" rel="noopener noreferrer" class="social-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              <span><strong>Instagram</strong>@slayergameryt_0007</span>
              <svg class="social-row__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1.5 12.5L12.5 1.5M12.5 1.5H5.5M12.5 1.5V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/SlayerGamerYT" target="_blank" rel="noopener noreferrer" class="social-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
              <span><strong>GitHub</strong>@SlayerGamerYT</span>
              <svg class="social-row__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1.5 12.5L12.5 1.5M12.5 1.5H5.5M12.5 1.5V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <div class="reveal reveal--right">
        <form class="contact-form" id="contact-form" novalidate>
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off"/>

          <div id="form-success" class="form-success" style="display:none" role="status">
            <div class="success-check">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18.5" stroke="var(--accent)" stroke-width="1.5"/><path d="M12 20l6 6 10-10" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3>Message sent!</h3>
            <p>I'll get back to you as soon as possible.</p>
            <button type="button" class="btn btn--outline" id="reset-btn"><span class="btn__shine"></span>Send Another</button>
          </div>

          <div id="form-error" class="form-error-msg" style="display:none" role="alert">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="var(--red)" stroke-width="1.5"/><path d="M9 5.5v4M9 12.5v.5" stroke="var(--red)" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span id="form-error-text"></span>
          </div>

          <div id="form-fields">
            <div class="form-row">
              <div class="form-group" id="group-name">
                <label for="fc-name" class="form-label">Name *</label>
                <input id="fc-name" name="name" type="text" class="form-input" placeholder="Your name" autocomplete="name"/>
                <span class="form-err-text" id="err-name" style="display:none"></span>
              </div>
              <div class="form-group" id="group-email">
                <label for="fc-email" class="form-label">Email *</label>
                <input id="fc-email" name="email" type="email" class="form-input" placeholder="you@example.com" autocomplete="email"/>
                <span class="form-err-text" id="err-email" style="display:none"></span>
              </div>
            </div>
            <div class="form-group">
              <label for="fc-subject" class="form-label">Subject</label>
              <input id="fc-subject" name="subject" type="text" class="form-input" placeholder="Project / Collab / Other"/>
            </div>
            <div class="form-group" id="group-message">
              <label for="fc-message" class="form-label">Message *</label>
              <textarea id="fc-message" name="message" class="form-input" rows="5" placeholder="Tell me about your project..."></textarea>
              <span class="form-err-text" id="err-message" style="display:none"></span>
            </div>
            <div class="form-group">
              <label for="fc-budget" class="form-label">Budget <em style="opacity:.45">(optional)</em></label>
              <select id="fc-budget" name="budget" class="form-input form-select">
                <option value="">Select a range…</option>
                <option>Under ₹5,000</option>
                <option>₹5,000 – ₹15,000</option>
                <option>₹15,000 – ₹50,000</option>
                <option>₹50,000+</option>
                <option>Negotiable</option>
              </select>
            </div>
            <button type="submit" class="btn btn--primary btn--full" id="submit-btn">
              <span class="btn__shine" aria-hidden="true"></span>
              <span id="btn-text">Send Message <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span id="btn-loading" style="display:none" class="btn__loading">
                <svg class="spin" width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-dasharray="28" stroke-dashoffset="10" opacity=".35"/><path d="M8 2a6 6 0 016 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                Sending…
              </span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
.success-check { animation: check-pop .5s var(--spring) forwards; }
[data-theme="light"] .form-success h3 { color: var(--accent); }
[data-theme="light"] .form-input option { background: var(--s1); color: var(--text); }
</style>

<script>
  const WORKER_URL = 'https://sgyt-contact.cshaily38.workers.dev';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successEl = document.getElementById('form-success')!;
  const errorEl = document.getElementById('form-error')!;
  const errorText = document.getElementById('form-error-text')!;
  const fieldsEl = document.getElementById('form-fields')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text')!;
  const btnLoading = document.getElementById('btn-loading')!;
  const resetBtn = document.getElementById('reset-btn')!;

  function showErr(id: string, groupId: string, msg: string) {
    const el = document.getElementById(id)!;
    el.textContent = msg; el.style.display = msg ? '' : 'none';
    document.getElementById(groupId)?.classList.toggle('has-error', !!msg);
  }

  function validate() {
    const name = (document.getElementById('fc-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('fc-email') as HTMLInputElement).value.trim();
    const message = (document.getElementById('fc-message') as HTMLTextAreaElement).value.trim();
    let ok = true;
    if (!name) { showErr('err-name','group-name','Name is required.'); ok = false; } else showErr('err-name','group-name','');
    if (!email) { showErr('err-email','group-email','Email is required.'); ok = false; }
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showErr('err-email','group-email','Enter a valid email address.'); ok = false; }
    else showErr('err-email','group-email','');
    if (message.length < 10) { showErr('err-message','group-message','Message must be at least 10 characters.'); ok = false; } else showErr('err-message','group-message','');
    return ok;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';
    if (!validate()) return;
    submitBtn.disabled = true; btnText.style.display = 'none'; btnLoading.style.display = '';
    const name = (document.getElementById('fc-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('fc-email') as HTMLInputElement).value.trim();
    const subject = (document.getElementById('fc-subject') as HTMLInputElement).value.trim();
    const message = (document.getElementById('fc-message') as HTMLTextAreaElement).value.trim();
    const budget = (document.getElementById('fc-budget') as HTMLSelectElement).value;
    try {
      const res = await fetch(WORKER_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, email, subject: subject || 'New message from SGYT Portfolio', message, budget }) });
      if (!res.ok) { const err = await res.json().catch(() => ({ error: 'Submission failed.' })); throw new Error(err.error || `HTTP ${res.status}`); }
      fieldsEl.style.display = 'none'; successEl.style.display = '';
    } catch (err: any) {
      errorText.textContent = err.message?.includes('fetch') ? 'Network error — check your connection.' : (err.message || 'Something went wrong.');
      errorEl.style.display = '';
      submitBtn.disabled = false; btnText.style.display = ''; btnLoading.style.display = 'none';
    }
  });

  resetBtn.addEventListener('click', () => {
    form.reset(); successEl.style.display = 'none'; fieldsEl.style.display = '';
    submitBtn.disabled = false; btnText.style.display = ''; btnLoading.style.display = 'none';
  });

  document.getElementById('fc-name')?.addEventListener('blur', () => { const v = (document.getElementById('fc-name') as HTMLInputElement).value.trim(); showErr('err-name','group-name',v ? '' : 'Name is required.'); });
  document.getElementById('fc-email')?.addEventListener('blur', () => { const v = (document.getElementById('fc-email') as HTMLInputElement).value.trim(); showErr('err-email','group-email',!v ? 'Email is required.' : !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? 'Enter a valid email.' : ''); });
  document.getElementById('fc-message')?.addEventListener('blur', () => { const v = (document.getElementById('fc-message') as HTMLTextAreaElement).value.trim(); showErr('err-message','group-message',v.length >= 10 ? '' : 'Message must be at least 10 characters.'); });
</script>
