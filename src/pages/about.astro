---
import Layout from '../layouts/Layout.astro';
const skills = {
  'Frontend': ['Vue 3','TypeScript','SCSS','Nuxt','React','Next.js'],
  'Backend': ['PHP','Node.js','Python','SQL','Go','Rust'],
  'DevOps': ['Docker','Linux','CI/CD','Git','Nginx','Apache'],
  'Design': ['Figma','WebGL','GLSL','CSS Animation','Blender'],
  'Mobile': ['Flutter','Dart','SwiftUI','Kotlin'],
  'Tools': ['WebAssembly','yt-dlp','HLS.js','Three.js','GSAP'],
};
const services = [
  { icon: '⟨/⟩', title: 'Full-Stack Development', desc: 'End-to-end web applications from database design (SQL) to server-side PHP to TypeScript frontends. Polyglot by design.' },
  { icon: '◈', title: 'UI / UX Design', desc: 'Clean, minimal interfaces with purposeful animation. Designed in Figma, built with SCSS and CSS3.' },
  { icon: '▣', title: 'WebGL & GLSL', desc: 'Custom vertex and fragment shaders, real-time rendering effects, and procedural visuals for the browser.' },
  { icon: '⚙', title: 'DevOps & CI/CD', desc: 'Automated deployment pipelines via GitHub Actions, Docker containers, and Linux server administration.' },
];
const timeline = [
  { year: '2023', title: 'Started Coding', desc: 'First lines of PHP. Built a basic website. Got hooked immediately.' },
  { year: '2024', title: 'Launched SGYTHUB', desc: 'Shipped a full polyglot platform: PHP, TypeScript, WebGL, CI/CD pipeline.' },
  { year: '2024', title: 'SGYTDL & VideoPlayer', desc: 'Built production-grade media tools using yt-dlp, HLS.js, and Shaka Player.' },
  { year: '2025', title: 'Going Deeper', desc: 'Exploring WebAssembly, Rust, and real-time graphics with GLSL shaders.' },
];
---
<Layout title="About — SlayerGamerYT" description="About Shaily Chaudhary (SlayerGamerYT) — self-taught full-stack developer, web designer, and content creator." canonical="https://slayergamer.eu.org/about">

  <section class="page-hero section">
    <div class="wrap">
      <span class="section__label blink-text">// about_me</span>
      <h1 class="page-hero__title reveal glitch" data-text="About">About</h1>
      <p class="page-hero__sub reveal" style="--delay:.1s">Self-taught. Self-driven. Shipping real things.</p>
    </div>
  </section>

  <!-- Bio -->
  <section class="section">
    <div class="wrap about-bio">
      <div class="about-bio__text reveal reveal--left">
        <h2 class="section__title" style="margin-bottom:1.25rem">I build things for the web<br/><em>and break them to learn.</em></h2>
        <p>I'm <strong>Shaily Chaudhary</strong>, known online as <strong>SlayerGamerYT (SGYT)</strong>. A self-taught full-stack developer and designer obsessed with crafting fast, beautiful, and technically deep digital experiences.</p>
        <p style="margin-top:1rem">When I'm not shipping code, I'm creating content on YouTube and Instagram, reverse-engineering tools, and pushing what's possible in the browser — from WebGL / GLSL shaders to WebAssembly modules.</p>
        <p style="margin-top:1rem">I work with a polyglot stack spanning <strong>PHP, TypeScript, Python, Lua, Dart</strong> and more — choosing the right tool for each problem rather than defaulting to a single ecosystem.</p>
        <div class="about-bio__actions">
          <a href="/contact" class="btn btn--primary"><span class="btn__shine"></span>Get In Touch <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a href="mailto:admin@slayergamer.eu.org" class="btn btn--outline"><span class="btn__shine"></span>Email Directly</a>
        </div>
      </div>
      <div class="about-bio__stats reveal reveal--right">
        <div class="stat-card"><span class="stat__num" data-count="3">0</span><span class="stat__label">Live Projects</span></div>
        <div class="stat-card"><span class="stat__num" data-count="25">0</span><span class="stat__label">Technologies</span></div>
        <div class="stat-card"><span class="stat__num" data-count="100" data-suffix="%">0%</span><span class="stat__label">Commitment</span></div>
        <div class="stat-card"><span class="stat__num" data-count="2">0</span><span class="stat__label">Years Building</span></div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section" style="border-top:1px solid var(--border)">
    <div class="wrap">
      <header class="section__head reveal">
        <div><span class="section__label blink-text">// journey</span><h2 class="section__title">The Timeline</h2></div>
      </header>
      <div class="timeline">
        {timeline.map((item, i) => (
          <div class="timeline__item reveal" style={`--delay:${i * 0.12}s`}>
            <div class="timeline__line" aria-hidden="true"></div>
            <div class="timeline__dot" aria-hidden="true"></div>
            <div class="timeline__content">
              <span class="timeline__year">{item.year}</span>
              <h3 class="timeline__title">{item.title}</h3>
              <p class="timeline__desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section skills-section">
    <div class="wrap">
      <header class="section__head reveal">
        <div><span class="section__label blink-text">// tech_stack</span><h2 class="section__title">Skills & Technologies</h2></div>
      </header>
      <div class="skill-categories">
        {Object.entries(skills).map(([cat, items]) => (
          <div class="skill-cat reveal">
            <h3 class="skill-cat__title">{cat}</h3>
            <div class="skills-grid">
              {items.map((skill, idx) => (
                <div class="skill-pill" style={`--i:${idx}`}>{skill}</div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" style="border-top:1px solid var(--border)">
    <div class="wrap">
      <header class="section__head reveal">
        <div><span class="section__label blink-text">// what_i_do</span><h2 class="section__title">Services</h2></div>
      </header>
      <div class="services-grid">
        {services.map((s, i) => (
          <div class="service-card reveal" style={`--delay:${i * 0.1}s`}>
            <span class="service-card__icon float">{s.icon}</span>
            <h3 class="service-card__title">{s.title}</h3>
            <p class="service-card__desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
/* Timeline */
.timeline { display: flex; flex-direction: column; gap: 0; position: relative; padding-left: 2rem; }
.timeline::before { content: ''; position: absolute; left: 7px; top: 0; bottom: 0; width: 1px; background: linear-gradient(180deg,var(--accent),var(--accent-2),transparent); opacity: .4; }
.timeline__item { position: relative; padding: 0 0 2.5rem 2rem; display: flex; flex-direction: column; gap: .4rem; }
.timeline__item:last-child { padding-bottom: 0; }
.timeline__dot { position: absolute; left: -1.85rem; top: .3rem; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent-d); transition: transform .3s var(--spring),box-shadow .3s; }
.timeline__item:hover .timeline__dot { transform: scale(1.5); box-shadow: 0 0 20px var(--accent); }
.timeline__line { display: none; }
.timeline__year { font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); font-family: var(--font-m); }
.timeline__title { font-family: var(--font-d); font-size: 1.15rem; font-weight: 700; color: var(--text); }
.timeline__desc { font-size: .875rem; color: var(--dim); line-height: 1.7; max-width: 480px; }
[data-theme="light"] .timeline::before { opacity: .3; }
[data-theme="light"] .timeline__dot { box-shadow: 0 0 8px rgba(0,200,83,0.4); }
[data-theme="light"] .timeline__item:hover .timeline__dot { box-shadow: 0 0 16px rgba(0,200,83,0.5); }
[data-theme="light"] .timeline__year { color: var(--accent); }
</style>
